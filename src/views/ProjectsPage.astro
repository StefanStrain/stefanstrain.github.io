---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useTranslations, type Lang } from '../i18n';
import { getProjects } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);

// Projects still being built: listed by name only, no page until the write-up is ready
const inProgress = {
  en: [
    { title: 'Grid Pulse', description: 'A data engineering pipeline for European electricity data.' },
    { title: 'Nemoria', description: 'A personal skill tree over my Obsidian notes, with spaced repetition.' },
    { title: 'bidwise', description: 'A small bid recommendation service for ad campaigns.' },
  ],
  fr: [
    { title: 'Grid Pulse', description: 'Un pipeline de data engineering pour les données électriques européennes.' },
    { title: 'Nemoria', description: 'Un arbre de compétences personnel construit sur mes notes Obsidian, avec répétition espacée.' },
    { title: 'bidwise', description: "Un petit service de recommandation d'enchères pour les campagnes publicitaires." },
  ],
}[lang];
---

<Base lang={lang} title={t('projects.title')} description={t('projects.intro')}>
  <section class="mx-auto max-w-6xl px-4 pt-40 sm:px-8" data-hero>
    <h1 class="text-[clamp(2.5rem,7vw,5.5rem)] leading-none font-medium" data-split>
      <span class="line"><span>{t('projects.title')}</span></span>
    </h1>
    <p class="mt-6 max-w-xl text-muted" data-reveal>{t('projects.intro')}</p>
  </section>
  <section class="mx-auto mt-20 grid max-w-6xl gap-x-8 gap-y-16 px-4 sm:px-8 md:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
  <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-8" data-reveal>
    <h2 class="text-sm tracking-wide text-muted uppercase">{t('projects.wip')}</h2>
    <ul class="mt-6 grid gap-6 md:grid-cols-3">
      {inProgress.map(({ title, description }) => (
        <li class="rounded-xl border border-dashed border-line p-5">
          <h3 class="text-lg text-ink">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
          <p class="mt-3 text-xs tracking-wide text-muted">{t('projects.wipNote')}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

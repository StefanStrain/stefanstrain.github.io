---
import Base from '../layouts/Base.astro';
import Glow from '../components/Glow.astro';
import { localePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('notFound.title')}>
  <section class="relative isolate overflow-hidden" data-hero>
    <Glow />
    <div class="mx-auto flex min-h-[70dvh] max-w-6xl flex-col justify-end px-4 pt-32 pb-10 sm:px-8">
      <h1 class="text-[clamp(2.5rem,8vw,6rem)] leading-none font-medium" data-split>
        <span class="line"><span>{t('notFound.headline')}</span></span>
      </h1>
      <a href={localePath(lang, '/')} class="mt-8 text-accent hover:underline" data-reveal>{t('notFound.back')}</a>
    </div>
  </section>
</Base>
